;; Home row mods QWERTY with tap-hold-release-keys and a fast-typing
;; nomods layer. Based on:
;; https://github.com/jtroo/kanata/blob/main/cfg_samples/home-row-mod-advanced.kbd
;;
;; Docs: https://jtroo.github.io/config.html#tap-hold
;; Discussion: https://github.com/jtroo/kanata/discussions/1455

;; sleep is Linux-only by name; register the OsCode for macOS output.
(deflocalkeys-macos
  sleep 142
)

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps
  q
  y u i
  a s d f g h j k l ;
  ;; § (grave) → caps-word; ISO key → backtick (old Karabiner grave swap)
  grv
  nonusbslash
  fn
  lctl
  ;; Left Command → Tab; Right Command → Backspace; Right Option → Delete
  lmet
  rmet
  ralt
)

(defvar
  ;; Consider different hold times per finger (pinkies slower, index faster).
  tap-time 200
  hold-time 150

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(deflayer base
  esc
  q
  y u i
  @a @s @d @f g h @j @k @l @;
  @cw
  grv
  @fnmed
  @med
  tab
  bspc
  del
)

;; Plain letters while rolling, but keep shift so CamelCase (jD, jK) works
;; without waiting for the idle return to base. Longer hold-time than base
;; to avoid accidental shifts during fast typing.
(deflayer nomods
  esc
  q
  y u i
  a s @dsft f g h j @ksft l ;
  @cw
  grv
  @fnmed
  @med
  tab
  bspc
  del
)

;; Hold fn or left ctrl: sleep on q; playback on y u i; mute/vol/brightness on g h j k l
(deflayer media
  _
  sleep
  prev pp next
  _ _ _ _ mute vold volu brdn brup _
  _
  _
  _
  _
  tab
  bspc
  del
)

(deffakekeys
  to-base (layer-switch base)
)

(defalias
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  ;; Hold left ctrl (or fn) to activate the media layer.
  ;; Physical lctl is free because Ctrl comes from home-row `a`.
  med (layer-while-held media)
  fnmed (multi fn (layer-while-held media))

  ;; Dedicated § key: toggle caps-word (auto-off on idle / word boundary).
  cw (caps-word-toggle 5000)

  ;; Shift-only tap-holds for the nomods (fast-typing) layer.
  ;; Plain tap-hold (no early hold) so rolls stay letters; hold ~300ms for shift.
  dsft (tap-hold $tap-time 300 d lsft)
  ksft (tap-hold $tap-time 300 k rsft)

  a (tap-hold-release-keys $tap-time $hold-time (multi a @tap) lctl $left-hand-keys)
  s (tap-hold-release-keys $tap-time $hold-time (multi s @tap) lalt $left-hand-keys)
  d (tap-hold-release-keys $tap-time $hold-time (multi d @tap) lsft $left-hand-keys)
  f (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lmet $left-hand-keys)
  j (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rmet $right-hand-keys)
  k (tap-hold-release-keys $tap-time $hold-time (multi k @tap) rsft $right-hand-keys)
  l (tap-hold-release-keys $tap-time $hold-time (multi l @tap) ralt $right-hand-keys)
  ; (tap-hold-release-keys $tap-time $hold-time (multi ; @tap) rctl $right-hand-keys)
)
