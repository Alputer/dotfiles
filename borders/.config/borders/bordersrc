#!/bin/bash
# Soft glass rim — focused window gets a glow so it reads clearly.

if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ]; then
  active_color="glow(0xff30d158)" # system green glow
  inactive_color=0x40ffffff
else
  active_color="glow(0xff34c759)" # system green glow
  inactive_color=0x333c3c43
fi

options=(
  style=round
  width=6.5
  hidpi=on
  active_color="$active_color"
  inactive_color="$inactive_color"
)

borders "${options[@]}"
