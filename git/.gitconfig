[user]
	name = Alp Tuna
	email = alp.tuna.453@gmail.com
	signingkey = ~/.ssh/github-personal-signkey.pub
[commit]
	gpgsign = true
[gpg]
	format = ssh
[core]
	editor = nvim
	pager = delta
[alias]
	difft = "!git -c diff.external=difft diff"
[merge]
	conflictstyle = diff3
	tool = nvimdiff
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[url "git@github-work:hubxco/"]
	insteadOf = git@github.com:hubxco/
[includeIf "gitdir:~/code/hubx/"]
	path = ~/dotfiles/git/work.gitconfig
