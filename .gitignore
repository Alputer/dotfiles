
# SSH keys stay out of this repo (private halves live in Bitwarden).
# config and known_hosts are tracked.
/ssh/*
!/ssh/config
!/ssh/known_hosts
!/ssh/*.pub

# Track only zsh config, not artifacts
zsh/*
!zsh/.zshrc
!zsh/.zshenv

# Neovim artifact?
.local

# fnox: age identities are private keys; local overrides hold personal sync caches
age*.txt
fnox.local.toml
.fnox.local.toml
