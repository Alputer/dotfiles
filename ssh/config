# Route SSH through the Bitwarden desktop agent (macOS .dmg socket).
Host *
    IdentityAgent ~/.bitwarden-ssh-agent.sock

# Personal GitHub account (alp.tuna.453@gmail.com)
Host github.com
    HostName github.com
    User git
    IdentityFile ~/dotfiles/ssh/github-personal.pub
    IdentitiesOnly yes

# Work Bitbucket account (alp.tuna@hubx.co)
Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/dotfiles/ssh/bitbucket-work.pub
    IdentitiesOnly yes

# Work GitHub account (alp.tuna@hubx.co)
Host github-work
    HostName github.com
    User git
    IdentityFile ~/dotfiles/ssh/github-work.pub
    IdentitiesOnly yes
